extends "res://tests/support/test_case.gd"
const Platform := preload("res://scripts/receive_platform.gd")
const Outcome := preload("res://scripts/receive_outcome.gd")
func _initialize() -> void: call_deferred("run")
func run() -> void:
	var short_arms := Platform.definition(1.86,false,0,{"stride_ratio":1.0,"wingspan_ratio":0.8})
	var long_arms := Platform.definition(1.86,false,0,{"stride_ratio":1.0,"wingspan_ratio":1.2})
	check(long_arms.forward_reach > short_arms.forward_reach and long_arms.side_reach > short_arms.side_reach,"Wingspan changes anatomical forward/lateral reach")
	check(long_arms.center.y < short_arms.center.y,"Long arms lower comfortable receiving platform")
	check(long_arms.morphology.exposed_lower_height < short_arms.morphology.exposed_lower_height,"Floor clipping reduces exposed lower region for long arms")
	var point := Vector3(0,0.6,-0.4)
	var high_grade := Platform.evaluate(short_arms,point-short_arms.center)
	var low_grade := Platform.evaluate(long_arms,point-long_arms.center)
	var high_outcome := Outcome.assess(high_grade,short_arms,point,0,Vector3.ZERO,0)
	var low_outcome := Outcome.assess(low_grade,long_arms,point,0,Vector3.ZERO,0)
	check(high_outcome.recovery == "knee" and low_outcome.recovery != "knee","Same low ball requires Knee for short arms but not long arms")
	var long_legs := Platform.definition(1.86,false,0,{"stride_ratio":1.2,"wingspan_ratio":0.8})
	check(long_legs.center.y > short_arms.center.y,"Long stride raises receiving stance without increasing total height")
	var short_body := Platform.definition(1.6,false)
	var tall_body := Platform.definition(2.1,false)
	check(short_body.morphology.anatomical_bottom < tall_body.morphology.anatomical_bottom,"Short athlete naturally reaches lower world heights")
	var mesh := Platform.mesh(long_arms)
	var lowest := INF
	for vertex in mesh.surface_get_arrays(0)[Mesh.ARRAY_VERTEX]: lowest = minf(lowest,vertex.y+long_arms.center.y)
	check(lowest >= -0.000001,"Debug mesh clips at floor without renormalizing grading")
	check(not Platform.contains(long_arms,Vector3(0,0.6,0.1)),"Long arms do not create a rear receiving platform")
	print("RECEIVE MORPHOLOGY: %d / %d passed"%[checks-failures,checks])
	quit(1 if failures else 0)
