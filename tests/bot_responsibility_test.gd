extends "res://tests/support/test_case.gd"
const Policy := preload("res://scripts/bot_contact_policy.gd")
func _initialize() -> void: call_deferred("run")
func run() -> void:
	var lab = load("res://map_graybox.tscn").instantiate()
	root.add_child(lab)
	lab.set_process(false)
	lab.set_physics_process(false)
	await physics_frame
	var bots = lab.training_bots
	lab.player.position = Vector3(2,0.03,7)
	var key := InputEventKey.new()
	key.keycode = KEY_G
	key.pressed = true
	lab._unhandled_input(key)
	check(bots.count_team(false) == 1 and bots.settings[0].net_index == -1,"G creates one unassigned bot")
	check(bots.actors[0].position == lab.player.position,"G spawns at the athlete location")
	check(bots.assign_responsibilities(0,false,1,{1:0,2:1,3:2},true),"One athlete can own all contacts plus block")
	check(bots.actors[0].position == bots.receive_target(1,false),"Net assignment teleports to side-specific receive target")
	var home: Vector3 = bots.settings[0].fixed_position
	bots.actors[0].position += Vector3(2,0,1)
	var displaced: Vector3 = bots.actors[0].position
	bots.edit_responsibilities(0,false,1,{1:0,2:1},true)
	check(bots.settings[0].fixed_position == home and bots.actors[0].position == displaced,"Responsibility edits preserve current and saved position")
	bots.edit_responsibilities(0,true,0,{1:0,2:1,3:2},true)
	check(bots.actors[0].position == bots.receive_target(0,true) and bots.actors[0].position.z < 0,"Net and side reassignment use destination receive target")
	lab.select_net(0)
	lab.player.position = Vector3(80,0,80)
	var setter: int = bots.summon_generic(true,0,{2:1,3:2},false)
	var other: int = bots.summon_generic(true,0,{1:0,2:0},false)
	check(Policy.recipient(bots,0,1).slot == setter,"First pass prioritizes the next-contact setter")
	check(Policy.recipient(bots,setter,2).slot == 0,"Second pass chooses an eligible third-contact teammate")
	check(Policy.recipient(bots,0,3).kind == "opponent","Third contact returns across net")
	bots.dismiss(setter)
	bots.dismiss(other)
	check(Policy.recipient(bots,0,1).kind == "self","Solo multi-contact bot can chain its own receive and set")
	bots.edit_responsibilities(0,true,0,{1:0},true)
	check(Policy.recipient(bots,0,1).kind == "opponent","No next-contact participant sends the ball over")
	bots.edit_responsibilities(0,true,0,{1:0,2:1,3:2},false)
	other = bots.summon_generic(true,0,{1:1},false)
	bots.actors[0].position = lab.court_center+Vector3(-2,0,-5)
	bots.actors[other].position = lab.court_center+Vector3(2,0,-5)
	lab.ball_active = true
	lab.ball.position = lab.court_center+Vector3(2,4,-5)
	lab.ball_velocity = Vector3(0,-1,0)
	lab.side_contacts.fill(0)
	bots.replan()
	check(bots.active_slot == other and bots.active_action == 1,"Nearest eligible floor-intersection owner chooses its configured action")
	var saved: Vector3 = bots.settings[other].fixed_position
	bots.actors[other].position = lab.court_center+Vector3(1,1,-0.001)
	lab._finish("test net fault")
	check(not bots.ready_to_serve(),"Serve waits while a returning bot still overlaps net")
	for frame in range(300): bots.tick_motion(1.0/60)
	check(bots.ready_to_serve() and bots.actors[other].position.distance_to(saved) < 0.03,"Every rally end returns bots and releases the net")
	check(bots.settings[other].fixed_position == saved,"Return movement never rewrites saved placement")
	for slot in range(bots.settings.size()): bots.dismiss(slot)
	for index in range(5): bots.summon_generic(false,2,{1:0},false)
	bots.ensure_receiver()
	check(bots.settings[4].enabled and bots.settings[4].net_index == 2 and not bots.settings[4].away,"Automatic serve receiver never overwrites an existing athlete")
	check(bots.count_net(0) == 1 and bots.settings[5].away,"Automatic receiver uses a free identity on the active court")
	var center: Vector3 = lab.court_center
	lab.player.position = center+Vector3(-2,0.03,4)
	bots._capture_receive_target()
	check(bots.receive_target(0,false).is_equal_approx(center+Vector3(-2,0,4)),"Receive target retains captured Home location")
	check(bots.receive_target(0,true).is_equal_approx(center+Vector3(2,0,-4)),"Away receive target rotates around the active net")
	lab.player.position = center+Vector3(1.5,0.03,-2)
	bots._capture_set_target()
	check(bots.set_delivery_target(0,false).is_equal_approx(center+Vector3(-1.5,0,2)),"Capturing Away set target updates Home with matching team-relative left/right")
	check(bots.set_delivery_target(0,true).is_equal_approx(center+Vector3(1.5,0,-2)),"Away set target retains captured location")
	lab.queue_free()
	await process_frame
	print("BOT RESPONSIBILITIES: %d / %d passed" % [checks-failures,checks])
	quit(1 if failures else 0)
