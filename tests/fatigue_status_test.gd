extends "res://tests/support/test_case.gd"
const Athlete = preload("res://scripts/athlete.gd")
func _initialize() -> void:
	call_deferred("run")
func run() -> void:
	var a := Athlete.new()
	var speed := a.speed()
	var leap := a.leap(1,1)
	a.spend(100)
	check(a.winded and not a.exhausted and a.winded_remaining == 10.5, "First depletion starts Winded")
	var equally_tired := Athlete.new()
	equally_tired.stamina = 0
	check(a.speed() == equally_tired.speed() and a.leap(1,1) == equally_tired.leap(1,1), "Winded itself only changes regeneration; low STA has its independent output penalty")
	a.spend(1)
	a.spend(0)
	check(a.winded and not a.exhausted and a.winded_remaining == 10.5, "Costs at zero do not escalate or refresh")
	a.recover(2,true)
	check(is_equal_approx(a.stamina,9) and is_equal_approx(a.winded_remaining,8.5), "Winded halves resting regeneration")
	a.spend(9)
	check(a.exhausted and not a.winded and a.exhaustion_remaining == 7, "Second positive-to-zero depletion escalates")
	check(is_equal_approx(a.speed(),speed*0.55) and is_equal_approx(a.leap(1,1),leap*0.65), "Existing Exhaustion movement/jump penalties remain")
	a.spend(0,2)
	check(a.hp == 97, "Existing Exhaustion HP cost multiplier remains")
	a.recover(6.5,true)
	check(a.stamina == 0 and a.exhausted and a.exhaustion_remaining == 0.5, "Exhaustion prevents all regeneration before seven seconds")
	a.spend(1)
	check(a.exhaustion_remaining == 0.5, "Costs at zero cannot refresh Exhaustion")
	a.recover(0.5,true)
	check(not a.exhausted and a.winded and a.stamina == 0 and a.winded_remaining == 10.5, "Seven seconds returns to fresh Winded at zero")
	a.recover(1,false)
	check(a.stamina == 1 and a.winded_remaining == 9.5, "Moving regeneration resumes at half rate")
	a.recover(9.5,false)
	check(not a.winded and not a.exhausted and a.stamina == 10.5, "Winded expires by timer even below fifty stamina")
	a.recover(1,false)
	check(a.stamina == 12.5, "Normal regeneration restored")
	a.spend(100)
	check(a.winded and not a.exhausted, "Depletion after expiry starts Winded again")
	a.recover(0.5,true)
	a.spend(100)
	a.recover(8,true)
	check(a.winded and not a.exhausted and is_equal_approx(a.winded_remaining,9.5) and is_equal_approx(a.stamina,4.5), "Large frame splits seven-second lock from Winded recovery")
	a.reset_fatigue()
	a.stamina = 0
	a.recover(11,true)
	check(a.stamina == 99 and not a.winded and not a.exhausted, "Reset clears all status timers")
	a.stamina = 100
	a.spend(100)
	a.recover(11,true)
	check(is_equal_approx(a.stamina,51.75) and not a.winded, "Frame crossing Winded expiry uses correct rates")
	var lab = load("res://main.tscn").instantiate()
	root.add_child(lab)
	lab.set_process(false)
	lab.set_physics_process(false)
	await physics_frame
	lab.athlete.spend(100)
	lab.hud.athlete_hud.update_values()
	check(lab.hud.athlete_hud.sta_value.text.contains("WINDED"), "HUD shows Winded countdown")
	lab.athlete.recover(1,true)
	lab.athlete.spend(100)
	lab.hud.athlete_hud.update_values()
	check(lab.hud.athlete_hud.sta_value.text.contains("EXHAUSTED"), "HUD shows Exhaustion countdown")
	lab._reset()
	check(lab.athlete.stamina == 100 and not lab.athlete.winded and not lab.athlete.exhausted and lab.athlete.exhaustion_remaining == 0 and lab.athlete.winded_remaining == 0, "Lab reset clears statuses and restores stamina")
	print("FATIGUE STATUS: %d / %d passed" % [checks-failures,checks])
	lab.queue_free()
	await process_frame
	quit(1 if failures else 0)
